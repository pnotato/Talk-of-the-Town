# Server only. Copy to .env; never expose to the client.
ANTHROPIC_API_KEY=
# Who writes what blobs think and say (docs/THINKING.md). The sim's numbers never depend on it.
# stub: template lines, no model calls. anthropic: Claude, needs ANTHROPIC_API_KEY.
BRAIN=stub
MODEL=claude-haiku-5-5
# Caps for BRAIN=anthropic (defaults shown). Past a cap the server uses the stub lines.
# VOICE_MAX_CALLS=2500        model calls per /api/run (a full run needs about 2,000)
# VOICE_MAX_USD=5             estimated spend for the server's lifetime
# VOICE_IN_FLIGHT=16          requests at once
# VOICE_TIMEOUT_SECONDS=30    per call, retries included
# Spend caps: the server refuses runs past these (422).
MAX_ROUNDS=50
MAX_BLOBS=100
# Write each finished run's JSON log here (empty: write nothing).
RUNS_DIR=runs/scratch
